# Krąg — konta. Skopiuj do .env i uzupełnij.

# Postgres (produkcja). W devie użyj `npm run dev:memory` (pg-mem, bez Postgresa).
DATABASE_URL=postgres://user:pass@localhost:5432/krag_accounts

# Google OAuth — ten sam Client ID, co w kliencie (index.html: GOOGLE_CLIENT_ID).
# Bez tego /auth/google zwraca 501. Publiczny, nie sekret.
GOOGLE_CLIENT_ID=539656658638-jc316c5afle3eoka5q4i7vd3amf82uj9.apps.googleusercontent.com

# Port serwera (domyślnie 8091).
PORT=8091
